{
  "name": "Bambu Downloader",
  "short_name": "BambuDL",
  "description": "Download and sync MakerWorld models",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1214",
  "theme_color": "#00ae42",
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "text": "url", "url": "url" }
  }
}